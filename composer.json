{
    "name": "krafty-sprouts/sharely",
    "description": "Sharely for TemeCMS: share buttons, a floating share bar, share counts kept on the site, Pinterest, highlight-to-share and follow buttons.",
    "type": "teme-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [{ "name": "Krafty Sprouts Media, LLC" }],
    "support": {
        "issues": "https://github.com/Krafty-Sprouts-Media-LLC/sharely/issues",
        "source": "https://github.com/Krafty-Sprouts-Media-LLC/sharely"
    },
    "require": {
        "php": "^8.4",
        "teme/contracts": "^1.3"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "KraftySprouts\\Sharely\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KraftySprouts\\Sharely\\Tests\\": "tests/",
            "KraftySprouts\\Sharely\\Tools\\": "tools/"
        }
    },
    "scripts": {
        "test": "pest",
        "package": "@php tools/package.php"
    },
    "config": {
        "allow-plugins": { "pestphp/pest-plugin": true },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
